   1:Core/Src/motor.c **** /**
   2:Core/Src/motor.c ****   ******************************************************************************
   3:Core/Src/motor.c ****   * @file    motor.c
   4:Core/Src/motor.c ****   * @brief   M3508 + C620 双环 PID 位置控制实现
   5:Core/Src/motor.c ****   ******************************************************************************
   6:Core/Src/motor.c ****   * CAN 协议（大疆 C620 电调）：
   7:Core/Src/motor.c ****   *
   8:Core/Src/motor.c ****   *   控制帧（STM32 -> 电调）：标准帧 ID = 0x200（ID 1~4 用 0x200，
   9:Core/Src/motor.c ****   *   ID 5~8 用 0x1FF）。8 字节数据 = 4 个 int16，大端序，依次对应
  10:Core/Src/motor.c ****   *   ID1、ID2、ID3、ID4 的电流指令，范围 -16384 ~ +16384（对应 -20A~+20A）。
  11:Core/Src/motor.c ****   *
  12:Core/Src/motor.c ****   *   反馈帧（电调 -> STM32）：标准帧 ID = 0x201 ~ 0x204 对应 ID1~ID4，
  13:Core/Src/motor.c ****   *   8 字节数据：
  14:Core/Src/motor.c ****   *       data[0..1]：转子机械角度 0~8191（大端）
  15:Core/Src/motor.c ****   *       data[2..3]：转速 rpm（int16，大端）
  16:Core/Src/motor.c ****   *       data[4..5]：实际转矩电流（int16，大端）
  17:Core/Src/motor.c ****   *       data[6]   ：电机温度（℃）
  18:Core/Src/motor.c ****   *       data[7]   ：保留
  19:Core/Src/motor.c ****   ******************************************************************************
  20:Core/Src/motor.c ****   */
  21:Core/Src/motor.c **** 
  22:Core/Src/motor.c **** #include "motor.h"
