   1:Core/Src/app.c **** /**
   2:Core/Src/app.c ****   ******************************************************************************
   3:Core/Src/app.c ****   * @file    app.c
   4:Core/Src/app.c ****   * @brief   应用层：1 kHz 控制节拍 + 定时切换目标位置
   5:Core/Src/app.c ****   ******************************************************************************
   6:Core/Src/app.c ****   * 本文件实现两件事：
   7:Core/Src/app.c ****   *
   8:Core/Src/app.c ****   *   1. 用 TIM6 产生 1 kHz 中断，在中断里做双环 PID 计算并通过 CAN 发电流；
   9:Core/Src/app.c ****   *      （不用串口、不用外部信号，纯定时器节拍）
  10:Core/Src/app.c ****   *
  11:Core/Src/app.c ****   *   2. 在主循环里每隔 TARGET_INTERVAL_MS 毫秒，把目标角度切换到
  12:Core/Src/app.c ****   *      kTargetsDeg[] 里的下一个位置，循环往复。
  13:Core/Src/app.c ****   *
  14:Core/Src/app.c ****   * 想改“转到哪些位置 / 多久换一个”，只需要改下面两个地方：
  15:Core/Src/app.c ****   *   - kTargetsDeg[]      目标角度表（单位：°，相对上电位置）
  16:Core/Src/app.c ****   *   - TARGET_INTERVAL_MS 每个位置停留的时间（单位：ms）
  17:Core/Src/app.c ****   ******************************************************************************
  18:Core/Src/app.c ****   */
  19:Core/Src/app.c **** 
  20:Core/Src/app.c **** #include "app.h"
  21:Core/Src/app.c **** #include "main.h"
  22:Core/Src/app.c **** 
  23:Core/Src/app.c **** /* ==========================================================================
  24:Core/Src/app.c ****  *                              用户可修改的配置
  25:Core/Src/app.c ****  * ========================================================================== */
  26:Core/Src/app.c **** 
  27:Core/Src/app.c **** /* 每个目标位置停留的时间：3000 ms = 3 秒换一个位置 */
  28:Core/Src/app.c **** #define TARGET_INTERVAL_MS     3000U
  29:Core/Src/app.c **** 
  30:Core/Src/app.c **** /* 目标位置表（输出轴角度，单位 °，相对上电位置；正负对应两个方向）
  31:Core/Src/app.c ****  * 这里演示：0° → 90° → 0° → -90° → 0° ... 循环。
ARM GAS  C:\Users\cks\AppData\Local\Temp\cce4b20f.s 			page 2


  32:Core/Src/app.c ****  * 想转别的角度直接改这个数组，比如 { 0, 45, 180, 270 }。 */
  33:Core/Src/app.c **** static const float kTargetsDeg[] =
  34:Core/Src/app.c **** {
  35:Core/Src/app.c ****     0.0f,
  36:Core/Src/app.c ****     90.0f,
  37:Core/Src/app.c ****     0.0f,
  38:Core/Src/app.c ****     -90.0f
  39:Core/Src/app.c **** };
  40:Core/Src/app.c **** 
  41:Core/Src/app.c **** #define TARGET_COUNT  (sizeof(kTargetsDeg) / sizeof(kTargetsDeg[0]))
  42:Core/Src/app.c **** 
  43:Core/Src/app.c **** /* ==========================================================================
  44:Core/Src/app.c ****  *                              私有变量
  45:Core/Src/app.c ****  * ========================================================================== */
  46:Core/Src/app.c **** 
  47:Core/Src/app.c **** /* 全局电机对象（ID = 1，对应 C620 拨码 1，反馈帧 0x201） */
  48:Core/Src/app.c **** Motor_t g_motor;
  49:Core/Src/app.c **** 
  50:Core/Src/app.c **** /* 上一次切换目标的时刻（HAL_GetTick 计数） */
  51:Core/Src/app.c **** static uint32_t s_last_target_tick = 0U;
  52:Core/Src/app.c **** 
  53:Core/Src/app.c **** /* 当前目标在 kTargetsDeg[] 里的下标 */
  54:Core/Src/app.c **** static uint32_t s_target_index = 0U;
  55:Core/Src/app.c **** 
  56:Core/Src/app.c **** /* 是否已经开始按节拍运动（要等第一帧反馈到了才开始，避免上电乱冲）
  57:Core/Src/app.c **** static uint8_t s_motion_started = 0U;
  58:Core/Src/app.c **** 
