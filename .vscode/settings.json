{
  "files.encoding": "utf8",
  "files.associations": {
    "*.h": "c",
    "*.s": "asm",
    "*.ld": "linkerscript"
  },
  "C_Cpp.default.configurationProvider": "ms-vscode.cpptools",
  // CubeIDE 已卸载，工具链统一用 MSYS2 ucrt64
  "cortex-debug.armToolchainPath": "C:/msys64/ucrt64/bin",
  "cortex-debug.openocdPath": "C:/msys64/ucrt64/bin/openocd.exe",
  "cortex-debug.gdbPath": "C:/msys64/ucrt64/bin/gdb-multiarch.exe",
  "terminal.integrated.defaultProfile.windows": "PowerShell"
}
